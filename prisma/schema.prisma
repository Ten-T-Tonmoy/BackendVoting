// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //dont mess the location
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//prisma will always generate in lower case
model User {
  id       Int     @id @default(autoincrement())
  username String  @unique //only can be used for findunique
  email    String  @unique
  name     String?
  password String
  birthday String?
}

